      }
    ],
    "views": [
      {
        "id": "register-page",
        "components": [
          "register-form"
        ],
        "actions": [
          {
            "usecase": "register-user",
            "inputFrom": {
              "name": "register-form.name",
              "email": "register-form.email",
              "password": "register-form.password"
            }
          }
        ]
      },
      {
        "id": "login-page",
        "components": [
          "login-form"
        ],
        "actions": [
          {
            "usecase": "login",
            "inputFrom": {
              "email": "login-form.email",
              "password": "login-form.password"
            }
          }
        ]
      },
      {
        "id": "todo-dashboard",
        "components": [
          "todo-list",
          "completed-todo-list",
          "todo-form"
        ],
        "actions": [
          {
            "usecase": "create-todo",
            "inputFrom": {
              "title": "todo-form.title",
              "description": "todo-form.description",
              "dueDate": "todo-form.dueDate"
            }
          },
          {
            "usecase": "complete-todo",
            "inputFrom": {
              "todoId": "todo-list.todoId"
            }
          },
          {
