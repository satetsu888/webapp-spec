{
  "webappSpec": "0.1.0",
  "name": "Todo App",
  "version": "1.0.0",
  "domain": {
    "entities": [
      {
        "id": "User",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          },
          {
            "name": "status",
            "type": "string",
            "required": true
          }
        ],
        "ownership": {
          "kind": "shared"
        },
        "states": [
          {
            "name": "active",
            "field": "status",
            "value": "active"
          },
          {
            "name": "deactivated",
            "field": "status",
            "value": "deactivated"
          }
        ],
        "traits": []
      },
      {
        "id": "Todo",
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string",
            "required": false
          },
          {
            "name": "completion",
            "type": "string",
            "required": true
          },
          {
            "name": "availability",
            "type": "string",
            "required": true
          },
          {
            "name": "dueDate",
            "type": "date",
            "required": false
          },
          {
            "name": "userId",
            "type": "User.id",
            "required": true
          }
        ],
        "ownership": {
          "kind": "personal",
          "ownerField": "userId"
        },
        "states": [
          {
            "name": "incomplete",
            "field": "completion",
            "value": "incomplete"
          },
          {
            "name": "complete",
            "field": "completion",
            "value": "complete"
          },
          {
            "name": "available",
            "field": "availability",
            "value": "available"
          }
        ],
        "traits": [
          {
            "name": "overdue",
            "description": "期日を過ぎた未完了のTODO",
            "derivedFrom": {
              "and": [
                {
                  "field": "completion",
                  "equals": "incomplete"
                },
                {
                  "field": "dueDate",
                  "op": "lt",
                  "value": "now"
                }
              ]
            }
          }
        ]
      }
    ],
    "relations": [
      {
        "id": "user-todos",
        "from": "User",
        "to": "Todo",
        "kind": "hasMany"
      }
    ],
    "transitions": [
      {
        "id": "register-user",
        "description": "ユーザーを登録する",
        "changes": [
          {
            "entity": "User",
            "state": {
              "from": "_start",
              "to": "active"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "deactivate-user",
        "description": "ユーザーを退会させる",
        "changes": [
          {
            "entity": "User",
            "state": {
              "from": "active",
              "to": "deactivated"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "create-todo",
        "description": "TODOを作成する",
        "changes": [
          {
            "entity": "Todo",
            "state": {
              "from": "_start",
              "to": "incomplete"
            },
            "scope": "target"
          },
          {
            "entity": "Todo",
            "state": {
              "from": "_start",
              "to": "available"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "complete-todo",
        "description": "TODOを完了にする",
        "changes": [
          {
            "entity": "Todo",
            "state": {
              "from": "incomplete",
              "to": "complete"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "reopen-todo",
        "description": "完了したTODOを再度有効にする",
        "changes": [
          {
            "entity": "Todo",
            "state": {
              "from": "complete",
              "to": "incomplete"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "delete-todo",
        "description": "TODOを削除する",
        "changes": [
          {
            "entity": "Todo",
            "state": {
              "from": "available",
              "to": "_end"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      }
    ]
  },
  "specs": [],
  "actors": [
    {
      "id": "anonymous",
      "authState": {
        "kind": "anonymous"
      }
    },
    {
      "id": "member",
      "authState": {
        "kind": "authenticated",
        "roles": [
          "member"
        ]
      },
      "entity": "User"
    }
  ],
  "usecases": [
    {
      "id": "register-user",
      "description": "新しいユーザーを登録する",
      "actor": "anonymous",
      "target": {
        "kind": "single",
        "entity": "User"
      },
      "input": {
        "name": "string",
        "email": "string"
      },
      "transition": "register-user",
      "errors": [
        {
          "when": "email_taken",
          "description": "すでに登録済みのメールアドレス"
        }
      ]
    },
    {
      "id": "deactivate-user",
      "description": "自分のアカウントを退会する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "User"
      },
      "input": {
        "userId": "actor.id"
      },
      "transition": "deactivate-user",
      "errors": []
    },
    {
      "id": "create-todo",
      "description": "新しいTODOを作成する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Todo"
      },
      "input": {
        "title": "string",
        "description": "string",
        "dueDate": "date",
        "userId": "actor.id"
      },
      "transition": "create-todo",
      "errors": []
    },
    {
      "id": "complete-todo",
      "description": "TODOを完了にする",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Todo",
        "scopeByActor": [
          "userId"
        ]
      },
      "input": {
        "todoId": "Todo.id"
      },
      "transition": "complete-todo",
      "errors": [
        {
          "when": "already_completed",
          "description": "すでに完了済みのTODO"
        }
      ]
    },
    {
      "id": "reopen-todo",
      "description": "完了したTODOを再度有効にする",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Todo",
        "scopeByActor": [
          "userId"
        ]
      },
      "input": {
        "todoId": "Todo.id"
      },
      "transition": "reopen-todo",
      "errors": [
        {
          "when": "not_completed",
          "description": "完了していないTODO"
        }
      ]
    },
    {
      "id": "delete-todo",
      "description": "TODOを削除する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Todo",
        "scopeByActor": [
          "userId"
        ]
      },
      "input": {
        "todoId": "Todo.id"
      },
      "transition": "delete-todo",
      "errors": []
    }
  ],
  "reactions": [],
  "scenarios": [
    {
      "id": "user-onboarding",
      "actor": "anonymous",
      "goal": "アカウントを作成してTODO管理を始める",
      "steps": [
        {
          "view": "register-page",
          "action": "register-user",
          "description": "登録フォームに入力してアカウントを作成する"
        }
      ]
    },
    {
      "id": "manage-todos",
      "actor": "member",
      "goal": "TODOを管理する",
      "steps": [
        {
          "view": "todo-dashboard",
          "action": "create-todo",
          "description": "新しいTODOを作成する"
        },
        {
          "view": "todo-dashboard",
          "action": "complete-todo",
          "description": "TODOを完了にする"
        },
        {
          "view": "todo-dashboard",
          "action": "reopen-todo",
          "description": "完了したTODOを再開する"
        },
        {
          "view": "todo-dashboard",
          "action": "delete-todo",
          "description": "不要なTODOを削除する"
        }
      ]
    },
    {
      "id": "account-management",
      "actor": "member",
      "goal": "アカウントを管理する",
      "steps": [
        {
          "view": "account-settings-page",
          "action": "deactivate-user",
          "description": "アカウントを退会する"
        }
      ]
    }
  ],
  "ui": {
    "components": [
      {
        "id": "register-form",
        "description": "ユーザー登録フォーム",
        "sources": [],
        "inputs": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          }
        ],
        "transforms": [],
        "displays": [],
        "outputs": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "id": "todo-list",
        "description": "未完了TODO一覧",
        "sources": [
          {
            "entity": "Todo",
            "matching": [
              "incomplete",
              "available"
            ],
            "fields": [
              "title",
              "description",
              "completion",
              "dueDate"
            ],
            "paginated": true,
            "sort": [
              {
                "field": "dueDate",
                "order": "asc"
              }
            ]
          }
        ],
        "inputs": [],
        "transforms": [],
        "displays": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "dueDate",
            "type": "date",
            "required": true
          },
          {
            "name": "isOverdue",
            "type": "boolean",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "todoId",
            "type": "Todo.id",
            "required": true
          }
        ]
      },
      {
        "id": "completed-todo-list",
        "description": "完了済みTODO一覧",
        "sources": [
          {
            "entity": "Todo",
            "matching": [
              "complete",
              "available"
            ],
            "fields": [
              "title",
              "description",
              "completion"
            ],
            "paginated": true
          }
        ],
        "inputs": [],
        "transforms": [],
        "displays": [
          {
            "name": "title",
            "type": "string",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "todoId",
            "type": "Todo.id",
            "required": true
          }
        ]
      },
      {
        "id": "todo-form",
        "description": "TODO作成フォーム",
        "sources": [],
        "inputs": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string",
            "required": true
          },
          {
            "name": "dueDate",
            "type": "date",
            "required": true
          }
        ],
        "transforms": [],
        "displays": [],
        "outputs": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string",
            "required": true
          },
          {
            "name": "dueDate",
            "type": "date",
            "required": true
          }
        ]
      },
      {
        "id": "account-settings",
        "description": "アカウント設定",
        "sources": [
          {
            "entity": "User",
            "matching": [
              "active"
            ],
            "fields": [
              "name",
              "email"
            ]
          }
        ],
        "inputs": [],
        "transforms": [],
        "displays": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "userId",
            "type": "User.id",
            "required": true
          }
        ]
      }
    ],
    "views": [
      {
        "id": "register-page",
        "components": [
          "register-form"
        ],
        "actions": [
          {
            "usecase": "register-user",
            "inputFrom": {
              "name": "register-form.name",
              "email": "register-form.email"
            }
          }
        ]
      },
      {
        "id": "todo-dashboard",
        "components": [
          "todo-list",
          "completed-todo-list",
          "todo-form"
        ],
        "actions": [
          {
            "usecase": "create-todo",
            "inputFrom": {
              "title": "todo-form.title",
              "description": "todo-form.description",
              "dueDate": "todo-form.dueDate"
            }
          },
          {
            "usecase": "complete-todo",
            "inputFrom": {
              "todoId": "todo-list.todoId"
            }
          },
          {
            "usecase": "reopen-todo",
            "inputFrom": {
              "todoId": "completed-todo-list.todoId"
            }
          },
          {
            "usecase": "delete-todo",
            "inputFrom": {
              "todoId": "todo-list.todoId"
            }
          }
        ]
      },
      {
        "id": "account-settings-page",
        "components": [
          "account-settings"
        ],
        "actions": [
          {
            "usecase": "deactivate-user",
            "inputFrom": {}
          }
        ]
      }
    ]
  },
  "fixtures": [
    {
      "id": "basic-setup",
      "description": "ユーザー2名とTODO数件の基本データ",
      "instances": [
        {
          "entity": "User",
          "id": "User-1",
          "fields": {
            "name": "Alice",
            "email": "alice@example.com",
            "status": "active"
          }
        },
        {
          "entity": "User",
          "id": "User-2",
          "fields": {
            "name": "Bob",
            "email": "bob@example.com",
            "status": "active"
          }
        },
        {
          "entity": "Todo",
          "id": "Todo-1",
          "fields": {
            "title": "Buy groceries",
            "description": "Milk, eggs, bread",
            "completion": "incomplete",
            "availability": "available",
            "userId": "User-1"
          }
        },
        {
          "entity": "Todo",
          "id": "Todo-2",
          "fields": {
            "title": "Write report",
            "description": "Q2 summary",
            "completion": "incomplete",
            "availability": "available",
            "userId": "User-1"
          }
        },
        {
          "entity": "Todo",
          "id": "Todo-3",
          "fields": {
            "title": "Review PR",
            "description": "#142",
            "completion": "complete",
            "availability": "available",
            "userId": "User-1"
          }
        },
        {
          "entity": "Todo",
          "id": "Todo-4",
          "fields": {
            "title": "Deploy staging",
            "description": "v2.1.0",
            "completion": "incomplete",
            "availability": "available",
            "userId": "User-2"
          }
        }
      ]
    }
  ]
}
