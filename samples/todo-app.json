{
  "webappSpec": "0.1.0",
  "name": "Todo App",
  "version": "1.0.0",
  "domain": {
    "entities": [
      {
        "id": "User",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          },
          {
            "name": "status",
            "type": "string",
            "required": true
          }
        ],
        "ownership": {
          "kind": "shared"
        },
        "states": [
          {
            "name": "active",
            "field": "status",
            "value": "active"
          },
          {
            "name": "deactivated",
            "field": "status",
            "value": "deactivated"
          }
        ],
        "traits": []
      },
      {
        "id": "Todo",
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string",
            "required": false
          },
          {
            "name": "completion",
            "type": "string",
            "required": true
          },
          {
            "name": "availability",
            "type": "string",
            "required": true
          },
          {
            "name": "dueDate",
            "type": "date",
            "required": false
          },
          {
            "name": "completedAt",
            "type": "datetime",
            "required": false
          },
          {
            "name": "userId",
            "type": "User.id",
            "required": true
          }
        ],
        "ownership": {
          "kind": "personal",
          "ownerField": "userId"
        },
        "states": [
          {
            "name": "incomplete",
            "field": "completion",
            "value": "incomplete"
          },
          {
            "name": "complete",
            "field": "completion",
            "value": "complete"
          },
          {
            "name": "available",
            "field": "availability",
            "value": "available"
          }
        ],
        "traits": [
          {
            "name": "overdue",
            "description": "期日を過ぎた未完了のTODO",
            "derivedFrom": {
              "and": [
                {
                  "field": "completion",
                  "equals": "incomplete"
                },
                {
                  "field": "dueDate",
                  "op": "lt",
                  "value": "now"
                }
              ]
            }
          },
          {
            "name": "approaching-deadline",
            "description": "期限まで24時間以内の未完了TODO",
            "derivedFrom": {
              "and": [
                {
                  "field": "completion",
                  "equals": "incomplete"
                },
                {
                  "field": "availability",
                  "equals": "available"
                },
                {
                  "field": "dueDate",
                  "op": "lte",
                  "value": "24_hours_from_now"
                },
                {
                  "field": "dueDate",
                  "op": "gt",
                  "value": "now"
                }
              ]
            }
          },
          {
            "name": "stale-completed",
            "description": "完了後1週間が経過した削除対象のTODO",
            "derivedFrom": {
              "and": [
                {
                  "field": "completion",
                  "equals": "complete"
                },
                {
                  "field": "availability",
                  "equals": "available"
                },
                {
                  "field": "completedAt",
                  "op": "lt",
                  "value": "7_days_ago"
                }
              ]
            }
          }
        ]
      }
    ],
    "relations": [
      {
        "id": "user-todos",
        "from": "User",
        "to": "Todo",
        "kind": "hasMany"
      }
    ],
    "transitions": [
      {
        "id": "register-user",
        "description": "ユーザーを登録する",
        "changes": [
          {
            "entity": "User",
            "state": {
              "from": "_start",
              "to": "active"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "deactivate-user",
        "description": "ユーザーを退会させる",
        "changes": [
          {
            "entity": "User",
            "state": {
              "from": "active",
              "to": "deactivated"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "create-todo",
        "description": "TODOを作成する",
        "changes": [
          {
            "entity": "Todo",
            "state": {
              "from": "_start",
              "to": "incomplete"
            },
            "scope": "target"
          },
          {
            "entity": "Todo",
            "state": {
              "from": "_start",
              "to": "available"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "complete-todo",
        "description": "TODOを完了にする",
        "changes": [
          {
            "entity": "Todo",
            "state": {
              "from": "incomplete",
              "to": "complete"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "reopen-todo",
        "description": "完了したTODOを再度有効にする",
        "changes": [
          {
            "entity": "Todo",
            "state": {
              "from": "complete",
              "to": "incomplete"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "delete-todo",
        "description": "TODOを削除する",
        "changes": [
          {
            "entity": "Todo",
            "state": {
              "from": "available",
              "to": "_end"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      }
    ]
  },
  "specs": [],
  "actors": [
    {
      "id": "anonymous",
      "authState": {
        "kind": "anonymous"
      }
    },
    {
      "id": "member",
      "authState": {
        "kind": "authenticated",
        "roles": [
          "member"
        ]
      },
      "authMethods": [
        { "kind": "email-password" }
      ],
      "entity": "User"
    },
    {
      "id": "system",
      "authState": {
        "kind": "authenticated",
        "roles": [
          "system"
        ]
      }
    }
  ],
  "usecases": [
    {
      "id": "register-user",
      "description": "新しいユーザーを登録する",
      "actor": "anonymous",
      "target": {
        "kind": "single",
        "entity": "User"
      },
      "input": {
        "name": "string",
        "email": "string",
        "password": "string"
      },
      "transition": "register-user",
      "errors": [
        {
          "when": "email_taken",
          "description": "すでに登録済みのメールアドレス"
        }
      ]
    },
    {
      "id": "login",
      "description": "メールアドレスとパスワードでログインする",
      "actor": "anonymous",
      "target": {
        "kind": "single",
        "entity": "User"
      },
      "input": {
        "email": "string",
        "password": "string"
      },
      "errors": [
        {
          "when": "invalid_credentials",
          "description": "メールアドレスまたはパスワードが正しくない"
        },
        {
          "when": "user_deactivated",
          "description": "退会済みのアカウント"
        }
      ]
    },
    {
      "id": "logout",
      "description": "ログアウトする",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "User"
      },
      "input": {
        "userId": "actor.id"
      },
      "errors": []
    },
    {
      "id": "deactivate-user",
      "description": "自分のアカウントを退会する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "User"
      },
      "input": {
        "userId": "actor.id"
      },
      "transition": "deactivate-user",
      "errors": []
    },
    {
      "id": "create-todo",
      "description": "新しいTODOを作成する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Todo"
      },
      "input": {
        "title": "string",
        "description": "string",
        "dueDate": "date",
        "userId": "actor.id"
      },
      "transition": "create-todo",
      "errors": []
    },
    {
      "id": "complete-todo",
      "description": "TODOを完了にする",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Todo",
        "scopeByActor": [
          "userId"
        ]
      },
      "input": {
        "todoId": "Todo.id"
      },
      "transition": "complete-todo",
      "errors": [
        {
          "when": "already_completed",
          "description": "すでに完了済みのTODO"
        }
      ]
    },
    {
      "id": "reopen-todo",
      "description": "完了したTODOを再度有効にする",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Todo",
        "scopeByActor": [
          "userId"
        ]
      },
      "input": {
        "todoId": "Todo.id"
      },
      "transition": "reopen-todo",
      "errors": [
        {
          "when": "not_completed",
          "description": "完了していないTODO"
        }
      ]
    },
    {
      "id": "delete-todo",
      "description": "TODOを削除する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Todo",
        "scopeByActor": [
          "userId"
        ]
      },
      "input": {
        "todoId": "Todo.id"
      },
      "transition": "delete-todo",
      "errors": []
    },
    {
      "id": "send-deadline-reminders",
      "description": "期限が近づいているTODOの所有者にリマインダーを送信する",
      "actor": "system",
      "target": {
        "kind": "collection",
        "entity": "Todo",
        "matching": [
          "approaching-deadline"
        ]
      },
      "input": {},
      "errors": []
    },
    {
      "id": "cleanup-completed-todos",
      "description": "完了後1週間が経過したTODOを自動削除する",
      "actor": "system",
      "target": {
        "kind": "collection",
        "entity": "Todo",
        "matching": [
          "stale-completed"
        ]
      },
      "input": {},
      "transition": "delete-todo",
      "errors": []
    }
  ],
  "reactions": [
    {
      "trigger": { "usecase": "send-deadline-reminders", "entity": "Todo" },
      "when": [],
      "notify": { "owner": "Todo" },
      "description": "期限が近づいているTODOの所有者に通知する"
    },
    {
      "trigger": { "usecase": "cleanup-completed-todos", "entity": "Todo" },
      "when": [],
      "notify": { "owner": "Todo" },
      "description": "完了後1週間が経過したTODOが自動削除されたことを所有者に通知する"
    }
  ],
  "scenarios": [
    {
      "id": "user-onboarding",
      "actor": "anonymous",
      "goal": "アカウントを作成してログインする",
      "steps": [
        {
          "view": "register-page",
          "action": "register-user",
          "description": "登録フォームに入力してアカウントを作成する"
        },
        {
          "view": "login-page",
          "action": "login",
          "description": "作成したアカウントでログインする"
        }
      ]
    },
    {
      "id": "login-flow",
      "actor": "anonymous",
      "goal": "ログインする",
      "steps": [
        {
          "view": "login-page",
          "action": "login",
          "description": "メールアドレスとパスワードでログインする"
        }
      ]
    },
    {
      "id": "manage-todos",
      "actor": "member",
      "goal": "TODOを管理する",
      "steps": [
        {
          "view": "todo-dashboard",
          "description": "TODO一覧を確認する"
        },
        {
          "view": "todo-dashboard",
          "action": "create-todo",
          "description": "新しいTODOを作成する"
        },
        {
          "view": "todo-dashboard",
          "action": "complete-todo",
          "description": "TODOを完了にする"
        },
        {
          "view": "todo-dashboard",
          "action": "reopen-todo",
          "description": "完了したTODOを再開する"
        },
        {
          "view": "todo-dashboard",
          "action": "delete-todo",
          "description": "不要なTODOを削除する"
        }
      ]
    },
    {
      "id": "account-management",
      "actor": "member",
      "goal": "アカウントを管理する",
      "steps": [
        {
          "view": "account-settings-page",
          "description": "アカウント情報を確認する"
        },
        {
          "view": "account-settings-page",
          "action": "logout",
          "description": "ログアウトする"
        },
        {
          "view": "account-settings-page",
          "action": "deactivate-user",
          "description": "アカウントを退会する"
        }
      ]
    },
    {
      "id": "deadline-notification-flow",
      "actor": "member",
      "goal": "期限が近いTODOの通知を受け取る",
      "steps": [
        {
          "view": "todo-dashboard",
          "action": "create-todo",
          "description": "期限付きのTODOを作成する"
        },
        {
          "usecase": "send-deadline-reminders",
          "actor": "system",
          "description": "期限が近づくとシステムがリマインダーを送信する"
        }
      ]
    },
    {
      "id": "auto-cleanup-flow",
      "actor": "member",
      "goal": "完了したTODOが自動的にクリーンアップされる",
      "steps": [
        {
          "view": "todo-dashboard",
          "action": "complete-todo",
          "description": "TODOを完了にする"
        },
        {
          "usecase": "cleanup-completed-todos",
          "actor": "system",
          "description": "完了後1週間が経過したTODOをシステムが自動削除する"
        }
      ]
    }
  ],
