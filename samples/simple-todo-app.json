{
  "webappSpec": "0.1.0",
  "name": "Simple Todo App",
  "version": "1.0.0",
  "domain": {
    "entities": [
      {
        "id": "Todo",
        "fields": [
          { "name": "title", "type": "string" },
          { "name": "status", "type": "string" }
        ],
        "ownership": { "kind": "shared" },
        "states": [
          { "name": "active", "field": "status", "value": "active" },
          { "name": "completed", "field": "status", "value": "completed" }
        ],
        "traits": []
      }
    ],
    "relations": [],
    "transitions": [
      {
        "id": "create-todo",
        "description": "TODOを作成する",
        "changes": [
          { "entity": "Todo", "state": { "from": "_start", "to": "active" }, "scope": "target" }
        ],
        "conditions": []
      },
      {
        "id": "complete-todo",
        "description": "TODOを完了にする",
        "changes": [
          { "entity": "Todo", "state": { "from": "active", "to": "completed" }, "scope": "target" }
        ],
        "conditions": []
      },
      {
        "id": "reopen-todo",
        "description": "完了したTODOを再度有効にする",
        "changes": [
          { "entity": "Todo", "state": { "from": "completed", "to": "active" }, "scope": "target" }
        ],
        "conditions": []
      }
    ]
  },
  "specs": [],
  "actors": [
    { "id": "user", "authState": { "kind": "anonymous" } }
  ],
  "usecases": [
    {
      "id": "list-todos",
      "description": "TODO一覧を表示する",
      "actor": "user",
      "target": { "kind": "collection", "entity": "Todo", "matching": ["active", "completed"] },
      "input": {},
      "errors": []
    },
    {
      "id": "create-todo",
      "description": "新しいTODOを作成する",
      "actor": "user",
      "target": { "kind": "single", "entity": "Todo" },
      "input": { "title": "string" },
      "transition": "create-todo",
      "errors": []
    },
    {
      "id": "complete-todo",
      "description": "TODOを完了にする",
      "actor": "user",
      "target": { "kind": "single", "entity": "Todo" },
      "input": { "todoId": "Todo.id" },
      "transition": "complete-todo",
      "errors": [
        { "when": "already_completed", "description": "すでに完了済みのTODO" }
      ]
    },
    {
      "id": "reopen-todo",
      "description": "完了したTODOを再度有効にする",
      "actor": "user",
      "target": { "kind": "single", "entity": "Todo" },
      "input": { "todoId": "Todo.id" },
      "transition": "reopen-todo",
      "errors": [
        { "when": "not_completed", "description": "完了していないTODO" }
      ]
    }
  ],
  "reactions": [],
  "scenarios": [
    {
      "id": "manage-todos",
      "actor": "user",
      "goal": "TODOを管理する",
      "steps": [
        { "view": "todo-page", "action": "list-todos", "description": "TODO一覧を確認する" },
        { "view": "todo-page", "action": "create-todo", "description": "新しいTODOを作成する" },
        { "view": "todo-page", "action": "complete-todo", "description": "TODOを完了にする" },
        { "view": "todo-page", "action": "reopen-todo", "description": "完了したTODOを再開する" }
      ]
    }
  ],
  "fixtures": [
    {
      "id": "basic-setup",
      "description": "TODO数件の基本データ",
      "instances": [
        { "entity": "Todo", "id": "Todo-1", "fields": { "title": "Buy groceries", "status": "active" } },
        { "entity": "Todo", "id": "Todo-2", "fields": { "title": "Clean the house", "status": "active" } },
        { "entity": "Todo", "id": "Todo-3", "fields": { "title": "Read a book", "status": "completed" } }
      ]
    }
  ],
  "ui": {
    "components": [
      {
        "id": "todo-list",
        "description": "未完了TODO一覧",
        "sources": [
          {
            "entity": "Todo",
            "matching": ["active"],
            "fields": ["title", "status"]
          }
        ],
        "inputs": [],
        "transforms": [],
        "displays": [
          { "name": "title", "type": "string" }
        ],
        "outputs": [{ "name": "todoId", "type": "Todo.id" }]
      },
      {
        "id": "completed-todo-list",
        "description": "完了済みTODO一覧",
        "sources": [
          {
            "entity": "Todo",
            "matching": ["completed"],
            "fields": ["title"]
          }
        ],
        "inputs": [],
        "transforms": [],
        "displays": [
          { "name": "title", "type": "string" }
        ],
        "outputs": [{ "name": "todoId", "type": "Todo.id" }]
      },
      {
        "id": "todo-form",
        "description": "TODO作成フォーム",
        "sources": [],
        "inputs": [
          { "name": "title", "type": "string" }
        ],
        "transforms": [],
        "displays": [],
        "outputs": [
          { "name": "title", "type": "string" }
        ]
      }
    ],
    "views": [
      {
        "id": "todo-page",
        "components": ["todo-list", "completed-todo-list", "todo-form"],
        "actions": [
          {
            "usecase": "list-todos",
            "inputFrom": {}
          },
          {
            "usecase": "create-todo",
            "inputFrom": { "title": "todo-form.title" }
          },
          {
            "usecase": "complete-todo",
            "inputFrom": { "todoId": "todo-list.todoId" }
          },
          {
            "usecase": "reopen-todo",
            "inputFrom": { "todoId": "completed-todo-list.todoId" }
          }
        ]
      }
    ]
  }
}
