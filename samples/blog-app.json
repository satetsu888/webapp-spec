            "body": "Every morning I start with a cup of coffee...",
            "status": "published",
            "authorId": "User-3",
            "publishedAt": "2025-05-22T08:00:00Z",
            "category": "Category-2"
          }
        },
        {
          "entity": "Post",
          "id": "Post-3",
          "fields": {
            "title": "Advanced React Patterns",
            "body": "In this article we explore render props and hooks...",
            "status": "draft",
