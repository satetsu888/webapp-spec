{
  "webappSpec": "0.1.0",
  "name": "Blog App",
  "version": "1.0.0",
  "domain": {
    "entities": [
      {
        "id": "User",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          },
          {
            "name": "role",
            "type": "string",
            "required": true
          },
          {
            "name": "status",
            "type": "string",
            "required": true
          }
        ],
        "ownership": {
          "kind": "shared"
        },
        "states": [
          {
            "name": "active",
            "field": "status",
            "value": "active"
          },
          {
            "name": "deactivated",
            "field": "status",
            "value": "deactivated"
          }
        ],
        "traits": [
          {
            "name": "is-admin",
            "description": "管理者権限を持つユーザー",
            "derivedFrom": {
              "field": "role",
              "equals": "admin"
            }
          }
        ]
      },
      {
        "id": "Post",
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "body",
            "type": "string",
            "required": true
          },
          {
            "name": "status",
            "type": "string",
            "required": true
          },
          {
            "name": "authorId",
            "type": "User.id",
            "required": true
          },
          {
            "name": "publishedAt",
            "type": "datetime",
            "required": false
          },
          {
            "name": "category",
            "type": "Category.id",
            "required": true
          }
        ],
        "ownership": {
          "kind": "personal",
          "ownerField": "authorId"
        },
        "states": [
          {
            "name": "draft",
            "field": "status",
            "value": "draft"
          },
          {
            "name": "published",
            "field": "status",
            "value": "published"
          },
          {
            "name": "archived",
            "field": "status",
            "value": "archived"
          }
        ],
        "traits": [
          {
            "name": "recent",
            "description": "直近7日以内に公開された記事",
            "derivedFrom": {
              "and": [
                {
                  "field": "status",
                  "equals": "published"
                },
                {
                  "field": "publishedAt",
                  "op": "gte",
                  "value": "7_days_ago"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "Comment",
        "fields": [
          {
            "name": "body",
            "type": "string",
            "required": true
          },
          {
            "name": "status",
            "type": "string",
            "required": true
          },
          {
            "name": "postId",
            "type": "Post.id",
            "required": true
          },
          {
            "name": "authorId",
            "type": "User.id",
            "required": true
          }
        ],
        "ownership": {
          "kind": "personal",
          "ownerField": "authorId"
        },
        "states": [
          {
            "name": "visible",
            "field": "status",
            "value": "visible"
          },
          {
            "name": "hidden",
            "field": "status",
            "value": "hidden"
          }
        ],
        "traits": []
      },
      {
        "id": "Category",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "slug",
            "type": "string",
            "required": true
          },
          {
            "name": "status",
            "type": "string",
            "required": true
          }
        ],
        "ownership": {
          "kind": "shared"
        },
        "states": [
          {
            "name": "active",
            "field": "status",
            "value": "active"
          },
          {
            "name": "archived",
            "field": "status",
            "value": "archived"
          }
        ],
        "traits": []
      }
    ],
    "relations": [
      {
        "id": "user-posts",
        "from": "User",
        "to": "Post",
        "kind": "hasMany"
      },
      {
        "id": "post-comments",
        "from": "Post",
        "to": "Comment",
        "kind": "hasMany"
      },
      {
        "id": "user-comments",
        "from": "User",
        "to": "Comment",
        "kind": "hasMany"
      },
      {
        "id": "category-posts",
        "from": "Category",
        "to": "Post",
        "kind": "hasMany"
      }
    ],
    "transitions": [
      {
        "id": "create-post",
        "description": "記事を下書きとして作成する",
        "changes": [
          {
            "entity": "Post",
            "state": {
              "from": "_start",
              "to": "draft"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "publish-post",
        "description": "記事を公開する",
        "changes": [
          {
            "entity": "Post",
            "state": {
              "from": "draft",
              "to": "published"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "unpublish-post",
        "description": "公開中の記事を下書きに戻す",
        "changes": [
          {
            "entity": "Post",
            "state": {
              "from": "published",
              "to": "draft"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "archive-post",
        "description": "記事をアーカイブする（関連コメントも非表示にする）",
        "changes": [
          {
            "entity": "Post",
            "state": {
              "from": "published",
              "to": "archived"
            },
            "scope": "target"
          },
          {
            "entity": "Comment",
            "state": {
              "from": "visible",
              "to": "hidden"
            },
            "scope": "related"
          }
        ],
        "conditions": []
      },
      {
        "id": "create-comment",
        "description": "記事にコメントを投稿する",
        "changes": [
          {
            "entity": "Comment",
            "state": {
              "from": "_start",
              "to": "visible"
            },
            "scope": "target"
          }
        ],
        "conditions": [
          {
            "field": "status",
            "equals": "published"
          }
        ]
      },
      {
        "id": "hide-comment",
        "description": "コメントを非表示にする",
        "changes": [
          {
            "entity": "Comment",
            "state": {
              "from": "visible",
              "to": "hidden"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "register-user",
        "description": "ユーザーを登録する",
        "changes": [
          {
            "entity": "User",
            "state": {
              "from": "_start",
              "to": "active"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "deactivate-user",
        "description": "ユーザーを退会させる",
        "changes": [
          {
            "entity": "User",
            "state": {
              "from": "active",
              "to": "deactivated"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "create-category",
        "description": "カテゴリを作成する",
        "changes": [
          {
            "entity": "Category",
            "state": {
              "from": "_start",
              "to": "active"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      },
      {
        "id": "archive-category",
        "description": "カテゴリをアーカイブする",
        "changes": [
          {
            "entity": "Category",
            "state": {
              "from": "active",
              "to": "archived"
            },
            "scope": "target"
          }
        ],
        "conditions": []
      }
    ]
  },
  "specs": [
    {
      "id": "post-title-length",
      "description": "記事のタイトルは空にできない",
      "rules": [
        {
          "when": {
            "field": "title",
            "op": "is_not_null"
          },
          "constraint": {
            "entity": "Post",
            "field": "title",
            "allowedValues": []
          }
        }
      ]
    }
  ],
  "actors": [
    {
      "id": "anonymous",
      "authState": {
        "kind": "anonymous"
      }
    },
    {
      "id": "member",
      "authState": {
        "kind": "authenticated",
        "roles": [
          "member"
        ]
      }
    },
    {
      "id": "admin",
      "authState": {
        "kind": "authenticated",
        "roles": [
          "admin"
        ]
      }
    }
  ],
  "usecases": [
    {
      "id": "list-my-posts",
      "description": "自分の記事を全ステータス含めて一覧する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Post"
      },
      "input": {},
      "errors": []
    },
    {
      "id": "view-post",
      "description": "記事の詳細を閲覧する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Post"
      },
      "input": {
        "postId": "Post.id"
      },
      "errors": []
    },
    {
      "id": "create-post",
      "description": "新しい記事を下書きとして作成する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Post"
      },
      "input": {
        "title": "string",
        "body": "string",
        "category": "Category.id"
      },
      "transition": "create-post",
      "errors": []
    },
    {
      "id": "publish-post",
      "description": "下書きの記事を公開する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Post"
      },
      "input": {
        "postId": "Post.id"
      },
      "transition": "publish-post",
      "errors": [
        {
          "when": "not_draft",
          "description": "下書き状態でない記事は公開できない"
        }
      ]
    },
    {
      "id": "unpublish-post",
      "description": "公開中の記事を下書きに戻す",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Post"
      },
      "input": {
        "postId": "Post.id"
      },
      "transition": "unpublish-post",
      "errors": [
        {
          "when": "not_published",
          "description": "公開中でない記事は非公開にできない"
        }
      ]
    },
    {
      "id": "archive-post",
      "description": "記事をアーカイブする",
      "actor": "admin",
      "target": {
        "kind": "single",
        "entity": "Post"
      },
      "input": {
        "postId": "Post.id"
      },
      "transition": "archive-post",
      "errors": [
        {
          "when": "not_published",
          "description": "公開中でない記事はアーカイブできない"
        }
      ]
    },
    {
      "id": "create-comment",
      "description": "記事にコメントを投稿する",
      "actor": "member",
      "target": {
        "kind": "single",
        "entity": "Comment"
      },
      "input": {
        "postId": "Post.id",
        "body": "string"
      },
      "transition": "create-comment",
      "errors": [
        {
          "when": "post_not_published",
          "description": "公開中でない記事にはコメントできない"
        }
      ]
    },
    {
      "id": "hide-comment",
      "description": "不適切なコメントを非表示にする",
      "actor": "admin",
      "target": {
        "kind": "single",
        "entity": "Comment"
      },
      "input": {
        "commentId": "Comment.id"
      },
      "transition": "hide-comment",
      "errors": []
    },
    {
      "id": "register-user",
      "description": "新しいユーザーを登録する",
      "actor": "anonymous",
      "target": {
        "kind": "single",
        "entity": "User"
      },
      "input": {
        "name": "string",
        "email": "string"
      },
      "transition": "register-user",
      "errors": []
    },
    {
      "id": "deactivate-user",
      "description": "ユーザーを退会させる",
      "actor": "admin",
      "target": {
        "kind": "single",
        "entity": "User"
      },
      "input": {
        "userId": "User.id"
      },
      "transition": "deactivate-user",
      "errors": []
    },
    {
      "id": "create-category",
      "description": "新しいカテゴリを作成する",
      "actor": "admin",
      "target": {
        "kind": "single",
        "entity": "Category"
      },
      "input": {
        "name": "string",
        "slug": "string"
      },
      "transition": "create-category",
      "errors": []
    },
    {
      "id": "archive-category",
      "description": "カテゴリをアーカイブする",
      "actor": "admin",
      "target": {
        "kind": "single",
        "entity": "Category"
      },
      "input": {
        "categoryId": "Category.id"
      },
      "transition": "archive-category",
      "errors": []
    }
  ],
  "reactions": [
    {
      "trigger": {
        "usecase": "create-comment",
        "entity": "Comment"
      },
      "when": [],
      "notify": {
        "owner": "Post"
      },
      "description": "コメントが投稿されたことを記事の著者に通知する"
    },
    {
      "trigger": {
        "usecase": "publish-post",
        "entity": "Post"
      },
      "when": [],
      "notify": {
        "external": "activity-log"
      },
      "description": "記事が公開されたことを記録する"
    }
  ],
  "scenarios": [
    {
      "id": "user-onboarding",
      "actor": "anonymous",
      "goal": "アカウントを作成する",
      "steps": [
        {
          "view": "register-page",
          "action": "register-user",
          "description": "登録フォームに入力してアカウントを作成する"
        }
      ]
    },
    {
      "id": "write-and-publish",
      "actor": "member",
      "goal": "記事を書いて公開する",
      "steps": [
        {
          "view": "my-drafts-page",
          "action": "list-my-posts",
          "description": "自分の記事一覧を確認する"
        },
        {
          "view": "new-post",
          "action": "create-post",
          "description": "新しい記事を下書きとして作成する"
        },
        {
          "view": "my-drafts-page",
          "action": "publish-post",
          "description": "下書きの記事を公開する"
        },
        {
          "view": "my-drafts-page",
          "action": "unpublish-post",
          "description": "公開中の記事を非公開に戻す"
        }
      ]
    },
    {
      "id": "read-and-comment",
      "actor": "member",
      "goal": "記事を読んでコメントする",
      "steps": [
        {
          "view": "home",
          "action": "view-post",
          "description": "記事一覧から記事を選んで閲覧する"
        },
        {
          "view": "post-page",
          "action": "create-comment",
          "description": "記事にコメントを投稿する"
        }
      ]
    },
    {
      "id": "moderate-content",
      "actor": "admin",
      "goal": "不適切なコンテンツを管理する",
      "steps": [
        {
          "view": "admin-moderation",
          "action": "hide-comment",
          "description": "不適切なコメントを非表示にする"
        },
        {
          "view": "admin-moderation",
          "action": "archive-post",
          "description": "不適切な記事をアーカイブする"
        },
        {
          "view": "admin-moderation",
          "action": "deactivate-user",
          "description": "違反ユーザーを無効化する"
        }
      ]
    },
    {
      "id": "manage-categories",
      "actor": "admin",
      "goal": "カテゴリを管理する",
      "steps": [
        {
          "view": "admin-categories",
          "action": "create-category",
          "description": "新しいカテゴリを作成する"
        },
        {
          "view": "admin-categories",
          "action": "archive-category",
          "description": "不要なカテゴリをアーカイブする"
        }
      ]
    }
  ],
  "fixtures": [
    {
      "id": "basic-setup",
      "description": "ユーザー3名・カテゴリ2件・記事4件・コメント3件の基本データ",
      "instances": [
        {
          "entity": "User",
          "id": "User-1",
          "fields": {
            "name": "Alice",
            "email": "alice@example.com",
            "role": "admin",
            "status": "active"
          }
        },
        {
          "entity": "User",
          "id": "User-2",
          "fields": {
            "name": "Bob",
            "email": "bob@example.com",
            "role": "member",
            "status": "active"
          }
        },
        {
          "entity": "User",
          "id": "User-3",
          "fields": {
            "name": "Charlie",
            "email": "charlie@example.com",
            "role": "member",
            "status": "active"
          }
        },
        {
          "entity": "Category",
          "id": "Category-1",
          "fields": {
            "name": "Technology",
            "slug": "technology",
            "status": "active"
          }
        },
        {
          "entity": "Category",
          "id": "Category-2",
          "fields": {
            "name": "Lifestyle",
