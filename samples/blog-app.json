            "authorId": "User-2"
          }
        }
      ]
    }
  ],
  "ui": {
    "components": [
      {
        "id": "post-list",
        "description": "公開済み記事の一覧",
        "sources": [
          {
            "entity": "Post",
            "matching": [
              "published"
            ],
            "fields": [
              "title",
              "category",
              "publishedAt",
              "authorId"
            ],
            "paginated": true,
            "sort": [
              {
                "field": "publishedAt",
                "order": "desc"
              }
            ]
          }
        ],
        "inputs": [],
        "transforms": [],
        "displays": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "category",
            "type": "string",
            "required": true
          },
          {
            "name": "publishedAt",
            "type": "datetime",
            "required": true
          },
          {
            "name": "authorName",
            "type": "string",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "postId",
            "type": "Post.id",
            "required": true
          }
        ]
      },
      {
        "id": "post-detail",
        "description": "記事の詳細表示とコメント一覧",
        "sources": [
          {
            "entity": "Post",
            "matching": [
              "published"
            ],
            "fields": [
              "title",
              "body",
              "category",
              "publishedAt",
              "authorId"
            ]
          },
          {
            "entity": "Comment",
            "matching": [
              "visible"
            ],
            "fields": [
              "body",
              "authorId"
            ],
            "paginated": true,
            "sort": [
              {
                "field": "body",
                "order": "asc"
              }
            ]
          }
        ],
        "inputs": [],
        "transforms": [],
        "displays": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "body",
            "type": "string",
            "required": true
          },
          {
            "name": "comments",
            "type": "Comment[]",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "postId",
            "type": "Post.id",
            "required": true
          },
          {
            "name": "commentId",
            "type": "Comment.id",
            "required": true
          }
        ]
      },
      {
        "id": "post-editor",
        "description": "記事の作成・編集フォーム",
        "sources": [],
        "inputs": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "body",
            "type": "string",
            "required": true
          },
          {
            "name": "category",
            "type": "Category.id",
            "required": true
          }
        ],
        "transforms": [],
        "displays": [],
        "outputs": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
